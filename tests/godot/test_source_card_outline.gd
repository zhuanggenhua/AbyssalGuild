extends SceneTree
const Outline = preload("res://scripts/ui/source_card_outline.gd")
func _init() -> void:
	var body := MeshInstance3D.new()
	body.mesh = PlaneMesh.new()
	body.transform.origin = Vector3(2, 3, 4)
	var metadata := {"shader_source_path": "Shaders/CardOutline.shadergraph", "properties": {"_OutlineSize": 0.2, "_OutlineColor": {"r": 0.1, "g": 0.3, "b": 0.6, "a": 0.8}, "_MinAlpha": 0.4, "_RotationSpeed": 2.1}}
	assert(Outline.create(body, metadata) == null)
	body.set_meta("mesh_to_card", Transform3D(Basis(Vector3.UP, PI), Vector3.ZERO))
	var outline = Outline.create(body, metadata)
	assert(outline.mesh == body.mesh)
	assert(outline.transform == body.transform)
	assert(outline.cast_shadow == GeometryInstance3D.SHADOW_CASTING_SETTING_OFF)
	assert(outline.process_mode == Node.PROCESS_MODE_ALWAYS)
	var mat: ShaderMaterial = outline.material_override
	assert(is_equal_approx(mat.get_shader_parameter("outline_size"), 0.2))
	assert(is_equal_approx(mat.get_shader_parameter("rotation_speed"), 2.1))
	assert(is_equal_approx(mat.get_shader_parameter("min_alpha"), 0.4))
	assert(mat.get_shader_parameter("outline_color").is_equal_approx(Color(0.1, 0.3, 0.6, 0.8)))
	var forward: Transform3D = mat.get_shader_parameter("mesh_to_card")
	var inverse: Transform3D = mat.get_shader_parameter("card_to_mesh")
	assert((forward * inverse).is_equal_approx(Transform3D.IDENTITY))
	outline._process(0)
	assert(mat.get_shader_parameter("unscaled_time") >= 0)
	assert(is_equal_approx(Outline.alpha_at(Vector2(1, 0.5), 0, 2, 0.2, 0.8), 0.8))
	assert(is_equal_approx(Outline.alpha_at(Vector2(0.5, 1), 0, 2, 0.2, 0.8), 0.64))
	assert(is_equal_approx(Outline.alpha_at(Vector2(0.5, 0), 0, 2, 0.2, 0.8), 0.32))
	assert(is_equal_approx(Outline.alpha_at(Vector2(1, 0.5), 6.283180236816406 / 2, 2, 0.2, 0.8), 0.8))
	outline.free()
	body.free()
	print("Source card outline: PASS (same mesh, graph properties, coordinate bridge, unscaled clock, no shadows)")
	quit()
