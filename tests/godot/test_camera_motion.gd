extends SceneTree
const Motion = preload("res://scripts/ui/camera_motion.gd")
var checks := 0
func check(value: bool, label: String) -> void:
	checks += 1
	assert(value,label)
func _init() -> void:
	var m = Motion.new()
	m.configure(Vector3(0,10,0))
	m.set_bounds(Rect2(-4,-3,8,6))
	m.pan(Vector2(100,50),10)
	check(m.target.is_equal_approx(Vector3(-1,10,-0.5)), "source pan height and screen/world reflection")
	var start := Vector3(0,10,0)
	var first: Vector3 = m.step(start,0.016,true)
	check(first.x < 0 and first.x > -1 and first.y == 10, "SmoothDamp approaches target without teleport")
	check(m.velocity.length() > 0, "SmoothDamp retains velocity")
	check(m.step(first,1,false) == first, "disabled input freezes ordinary smoothing")
	var current: Vector3 = first
	for i in 100: current = m.step(current,0.016,true)
	check(current.distance_to(m.target) < 0.001, "smoothing converges without overshoot")
	m.pan(Vector2(-10000,10000),10)
	check(m.target.x == 4.5 and m.target.z == -3.5, "source padded target clamp")
	m.set_bounds(Rect2(-1,-1,2,2))
	check(m.target.x == 1.5 and m.target.z == -1.5, "shrinking bounds immediately clamps target")
	m.configure(Vector3(0,10,0))
	m.set_bounds(Rect2(-20,-20,40,40))
	var forward := Vector3(0,-1,0)
	check(m.zoom(1,forward) and m.target.y == 9, "zoom advances target along camera forward")
	check(not m.zoom(10,forward) and m.target.y == 9, "out-of-range zoom rejects whole step")
	check(not m.zoom(0.001,forward), "source small scroll threshold")
	check(not m.zoom(1,Vector3.RIGHT), "horizontal forward cannot divide distance")
	m.move_to(Vector3(0,10,0),Vector3(20,2,-4),forward,0.5)
	var midpoint: Vector3 = m.step(Vector3(0,10,0),0.25,false)
	check(midpoint.is_equal_approx(Vector3(15,10,-3)), "focus runs unscaled despite locked input with explicit OutQuad")
	var end: Vector3 = m.step(midpoint,0.25,false)
	check(end.is_equal_approx(Vector3(20,10,-4)) and m.focus.is_empty(), "focus uses desired distance8 and preserves target height")
	m.set_bounds(Rect2(-20,-20,40,40))
	check(m.target == end, "unchanged bounds do not re-clamp completed focus")
	m.move_to(end,Vector3(100,0,0),forward,0)
	check(m.step(end,0.01,false) == Vector3(100,8,0), "zero-duration focus safely completes without arbitrary clamp")
	m.set_bounds(Rect2(-20,-20,40,40))
	check(m.target.x == 100, "focus outside board remains until input or bounds change")
	m.pan(Vector2.ZERO,8)
	check(m.target.x == 20.5, "subsequent source pan clamps focus target")
	m.configure(Vector3.ONE)
	check(m.target == Vector3.ONE and m.velocity == Vector3.ZERO and m.focus.is_empty(), "scene reset clears camera-motion state")
	var data := {"scenes":[{"name":"Main","documents":[{"fields":{"m_SourcePrefab":{"guid":"p"},"m_Modification":{"m_Modifications":[{"target":{"fileID":"7"},"propertyPath":"panSpeed","value":0.2}]}}}]}],"referenced_prefabs":[{"guid":"p","documents":[{"script_class":"CameraController","file_id":7,"fields":{"panSpeed":0.01}}]}]}
	check(Motion.source_settings(data,"Main").panSpeed == 0.2, "matching scene component override applied")
	check(Motion.source_settings(data,"Island").is_empty(), "missing scene never adopts arbitrary controller")
	print("Camera motion checks: %d passed" % checks)
	quit()
